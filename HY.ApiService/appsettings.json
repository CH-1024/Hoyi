{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "None"
    }
  },


  "ConnectionStrings": {
    // 开发环境
    "Redis": "hoyi.net.cn:6379,password=12345678,defaultDatabase=0",
    "MySql": "server=hoyi.net.cn;port=3306;database=HY;user=cheng;password=12345678;"

    //// 生产环境
    //"Redis": "127.0.0.1:6379,password=12345678,defaultDatabase=0",
    //"MySql": "server=127.0.0.1;port=3306;database=HY;user=root;password=12345678;"
  },


  "AllowedHosts": "*",


  "Kestrel": {
    "Limits": {
      // 100MB
      "MaxRequestBodySize": 104857600
    },
    "Endpoints": {

      "Http": { "Url": "http://*:8002" },

      // 开发环境
      "Https": { "Url": "https://*:8003" }

      //// 生产环境
      //"Https": {"Url": "https://*:8003", "Certificate": {"Path": "/etc/ssl/aspnet/cert.pfx", "Password": "12345678"}}

    }
  },


  "SignalR": {
    "KeepAlive": 15,
    "ClientTimeout": 30
  },


  "Expire": {
    "Call": 30,
    "FileChallenge": 600
  },


  "FFmpeg": {
    // Windows
    "Path": "C:\\ffmpeg\\bin\\ffmpeg.exe"

    //// Linux
    //"Path": "ffmpeg"
  },


  "MediaStorage": {
    "Type": "Local",

    // Windows
    "Local": {
      "Bucket": "/",
      "Path": "hy\\uploads"
    },

    //// Linux
    //"Local": {
    //  "Bucket": "/",
    //  "Path": "hy/uploads"
    //},

    "OSS": {
      "Bucket": "xx",
      "Path": "xx"
    },
    "COS": {
      "Bucket": "xx",
      "Path": "xx"
    }
  }

}