<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HY.MAUI.Controls.CallVoiceBubble"
             x:Name="_CallVoiceBubble"
             xmlns:msgvm="clr-namespace:HY.MAUI.Models.MsgVM"
             xmlns:controls="clr-namespace:HY.MAUI.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="msgvm:CallVoiceMessageVM">

    <ContentView.Resources>

        <PathGeometry x:Key="VioceIcon" Figures="M360 548.032c0.192 4.16 1.92 7.424 2.112 11.584 1.92 7.424 1.92 7.424 2.112 11.52 8.32 46.272-17.536 77.568-99.84 108.416-118.08 44.16-204.544 28.544-224.448-34.624-10.304-30.336-12.224-37.76-13.696-56-5.376-56.384 24-108.736 101.184-164.224 160.96-95.552 334.4-121.728 507.2-94.592 121.088 19.84 237.248 65.664 287.552 105.6 48.448 36.8 74.24 75.52 74.752 115.52-2.624 69.248-20.416 115.2-56.576 139.52-51.136 32.512-235.264-7.424-270.72-55.68-16.768-22.464-19.136-42.368-10.688-66.112l2.24-7.68 1.536-5.056a92.992 92.992 0 0 0-6.272-9.728c-21.376-29.312-63.488-51.328-135.68-51.456-89.216 2.752-160.576 33.856-160.768 52.992z" />

    </ContentView.Resources>

    <ContentView.Triggers>

        <DataTrigger TargetType="ContentView" Binding="{Binding Message_Status}" Value="Deleted">
            <Setter Property="IsVisible" Value="False"/>
        </DataTrigger>

    </ContentView.Triggers>


    <Grid ColumnDefinitions="50,*,50" Margin="0,6">

        <!-- ================== 头像 ================== -->
        <toolkit:AvatarView BackgroundColor="Black" Stroke="Transparent" CornerRadius="5" Padding="0" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" VerticalOptions="Start" IsVisible="False">

            <!-- 绑定头像 -->
            <toolkit:AvatarView.ImageSource>
                <UriImageSource Uri="{Binding Sender_Avatar}" CacheValidity="10:00:00:00" CachingEnabled="True"/>
            </toolkit:AvatarView.ImageSource>

            <toolkit:AvatarView.Triggers>

                <!-- 自己的消息头像在右 -->
                <DataTrigger TargetType="toolkit:AvatarView" Binding="{Binding IsSelf}" Value="True">
                    <Setter Property="Grid.Column" Value="2"/>
                    <Setter Property="IsVisible" Value="True"/>
                </DataTrigger>
                <DataTrigger TargetType="toolkit:AvatarView" Binding="{Binding IsSelf}" Value="False">
                    <Setter Property="Grid.Column" Value="0"/>
                    <Setter Property="IsVisible" Value="True"/>
                </DataTrigger>

            </toolkit:AvatarView.Triggers>

            <toolkit:AvatarView.GestureRecognizers>
                <TapGestureRecognizer Tapped="ContactDetail_Tapped"/>
            </toolkit:AvatarView.GestureRecognizers>

        </toolkit:AvatarView>

        <!-- ================== 消息区域 ================== -->
        <Grid Grid.Column="1" ColumnDefinitions="auto,*,auto" HorizontalOptions="Start">

            <Grid.Triggers>

                <!-- 自己的消息在右 -->
                <DataTrigger TargetType="Grid" Binding="{Binding IsSelf}" Value="True">
                    <Setter Property="HorizontalOptions" Value="End"/>
                </DataTrigger>

            </Grid.Triggers>

            <!-- 气泡 -->
            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Dark={StaticResource Gray900}, Light={StaticResource Secondary}}" StrokeThickness="0" Padding="8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Bubble_Primary_Tapped" Buttons="Primary"/>
                    <TapGestureRecognizer Tapped="Bubble_Secondary_Tapped" Buttons="Secondary"/>
                </Border.GestureRecognizers>

                <!-- 阴影 -->
                <Border.Shadow>
                    <Shadow Brush="Gray" Offset="0,1" Radius="1" Opacity="1" />
                </Border.Shadow>

                <!-- 圆角 -->
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8,8,8,8">
                        <!--<RoundRectangle.Triggers>

                            <DataTrigger TargetType="RoundRectangle" Binding="{Binding IsSelf}" Value="True">
                                <Setter Property="CornerRadius" Value="8,0,8,8"/>
                            </DataTrigger>

                        </RoundRectangle.Triggers>-->
                    </RoundRectangle>
                </Border.StrokeShape>

                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelf}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Green1}, Light={StaticResource PrimaryDark}}"/>
                    </DataTrigger>
                </Border.Triggers>

                <!-- 内容 -->
                <Grid ColumnDefinitions="auto,*,auto" HorizontalOptions="Start">

                    <Grid.Triggers>

                        <!-- 自己的消息在右 -->
                        <DataTrigger TargetType="Grid" Binding="{Binding IsSelf}" Value="True">
                            <Setter Property="HorizontalOptions" Value="End"/>
                        </DataTrigger>

                    </Grid.Triggers>

                    <Path Grid.Column="0" Margin="8,0" WidthRequest="18" HeightRequest="18" Stroke="{AppThemeBinding Dark={StaticResource TextPrimary}, Light={StaticResource TextSecondary}}" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" Data="{StaticResource VioceIcon}" IsVisible="False">
                        <Path.Triggers>
                            <DataTrigger TargetType="Path" Binding="{Binding IsSelf}" Value="False">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Path.Triggers>
                    </Path>

                    <!-- 文字提示 -->
                    <Label Grid.Column="1" TextColor="{AppThemeBinding Dark={StaticResource TextPrimary}, Light={StaticResource TextSecondary}}" FontSize="Body" MinimumHeightRequest="0" Padding="0" LineBreakMode="WordWrap">
                        <Label.Triggers>

                            <DataTrigger TargetType="Label" Binding="{Binding IsSelf}" Value="True">
                                <Setter Property="Margin" Value="8,0,0,0"/>
                            </DataTrigger>

                            <DataTrigger TargetType="Label" Binding="{Binding IsSelf}" Value="False">
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </DataTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="True"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Expired"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="对方无应答"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="False"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Expired"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="无应答"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Abnormal"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="{Binding Duration,StringFormat='通话异常'}"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Ended"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="{Binding Duration, StringFormat='通话时长 {0:hh\\:mm\\:ss}'}" />
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="True"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Rejected"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="对方已拒绝"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="False"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Rejected"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="已拒绝"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="True"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Cancelled"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="已取消"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="False"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Cancelled"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="对方已取消"/>
                            </MultiTrigger>

                        </Label.Triggers>
                    </Label>

                    <Path Grid.Column="2" Margin="8,0" WidthRequest="18" HeightRequest="18" Stroke="{AppThemeBinding Dark={StaticResource TextPrimary}, Light={StaticResource TextSecondary}}" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" Data="{StaticResource VioceIcon}" IsVisible="False" ScaleX="-1">
                        <Path.Triggers>
                            <DataTrigger TargetType="Path" Binding="{Binding IsSelf}" Value="True">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Path.Triggers>
                    </Path>

                </Grid>
            </Border>

        </Grid>

    </Grid>

</ContentView>