<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HY.MAUI.Controls.CallVideoBubble"
             x:Name="_CallVideoBubble"
             xmlns:msgvm="clr-namespace:HY.MAUI.Models.MsgVM"
             xmlns:controls="clr-namespace:HY.MAUI.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="msgvm:CallVideoMessageVM">

    <ContentView.Resources>

        <PathGeometry x:Key="VideoIcon" Figures="M94.208 192S0 192 0 282.624v458.752C0 832 94.272 832 94.272 832h498.176s94.272 0 94.272-90.624v-456C686.656 192 592.32 192 592.32 192H94.208z m861.312 49.472L769.792 384.256c-5.44 5.504-8.256 11.008-8.256 16.512v227.968c0 5.504 2.816 13.76 8.32 16.512L955.52 788.032c3.84 3.456 8.768 5.376 13.888 5.504 2.816 0 5.504 0 11.072-2.752 8.32-2.752 11.072-10.944 11.072-19.2V257.92a20.672 20.672 0 0 0-13.888-19.2c-8.256-2.752-16.576-2.752-22.144 2.752z" />

    </ContentView.Resources>

    <ContentView.Triggers>

        <DataTrigger TargetType="ContentView" Binding="{Binding Message_Status}" Value="Deleted">
            <Setter Property="IsVisible" Value="False"/>
        </DataTrigger>

    </ContentView.Triggers>


    <Grid ColumnDefinitions="50,*,50" Margin="0,6">

        <!-- ================== 头像 ================== -->
        <toolkit:AvatarView BackgroundColor="Black" StrokeThickness="0" CornerRadius="5" Padding="0" Margin="0" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" VerticalOptions="Start" IsVisible="False">

            <!-- 绑定头像 -->
            <toolkit:AvatarView.ImageSource>
                <UriImageSource Uri="{Binding Sender_Avatar}" CacheValidity="10:00:00:00" CachingEnabled="True"/>
            </toolkit:AvatarView.ImageSource>

            <toolkit:AvatarView.Triggers>

                <!-- 自己的消息头像在右 -->
                <DataTrigger TargetType="toolkit:AvatarView" Binding="{Binding IsSelf}" Value="True">
                    <Setter Property="Grid.Column" Value="2"/>
                    <Setter Property="IsVisible" Value="True"/>
                </DataTrigger>
                <DataTrigger TargetType="toolkit:AvatarView" Binding="{Binding IsSelf}" Value="False">
                    <Setter Property="Grid.Column" Value="0"/>
                    <Setter Property="IsVisible" Value="True"/>
                </DataTrigger>

            </toolkit:AvatarView.Triggers>

            <toolkit:AvatarView.GestureRecognizers>
                <TapGestureRecognizer Tapped="ContactDetail_Tapped"/>
            </toolkit:AvatarView.GestureRecognizers>

        </toolkit:AvatarView>

        <!-- ================== 消息区域 ================== -->
        <Grid Grid.Column="1" ColumnDefinitions="auto,*,auto" HorizontalOptions="Start">

            <Grid.Triggers>

                <!-- 自己的消息在右 -->
                <DataTrigger TargetType="Grid" Binding="{Binding IsSelf}" Value="True">
                    <Setter Property="HorizontalOptions" Value="End"/>
                </DataTrigger>

            </Grid.Triggers>

            <!-- 气泡 -->
            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Dark={StaticResource Gray950}, Light={StaticResource Secondary}}" StrokeThickness="0" Padding="8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Bubble_Primary_Tapped" Buttons="Primary"/>
                    <TapGestureRecognizer Tapped="Bubble_Secondary_Tapped" Buttons="Secondary"/>
                </Border.GestureRecognizers>

                <!-- 阴影 -->
                <Border.Shadow>
                    <Shadow Brush="Gray" Offset="0,1" Radius="1" Opacity="1" />
                </Border.Shadow>

                <!-- 圆角 -->
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8,8,8,8">
                        <!--<RoundRectangle.Triggers>

                            <DataTrigger TargetType="RoundRectangle" Binding="{Binding IsSelf}" Value="True">
                                <Setter Property="CornerRadius" Value="8,0,8,8"/>
                            </DataTrigger>

                        </RoundRectangle.Triggers>-->
                    </RoundRectangle>
                </Border.StrokeShape>

                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelf}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray900}, Light={StaticResource PrimaryDark}}"/>
                    </DataTrigger>
                </Border.Triggers>

                <!-- 内容 -->
                <Grid ColumnDefinitions="auto,*,auto" HorizontalOptions="Start">

                    <Grid.Triggers>

                        <!-- 自己的消息在右 -->
                        <DataTrigger TargetType="Grid" Binding="{Binding IsSelf}" Value="True">
                            <Setter Property="HorizontalOptions" Value="End"/>
                        </DataTrigger>

                    </Grid.Triggers>

                    <Path Grid.Column="0" Margin="8,0" WidthRequest="18" HeightRequest="18" Stroke="{AppThemeBinding Dark={StaticResource TextPrimary}, Light={StaticResource TextSecondary}}" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" Data="{StaticResource VideoIcon}" IsVisible="False">
                        <Path.Triggers>
                            <DataTrigger TargetType="Path" Binding="{Binding IsSelf}" Value="False">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Path.Triggers>
                    </Path>

                    <!-- 文字提示 -->
                    <Label Grid.Column="1" TextColor="{AppThemeBinding Dark={StaticResource TextPrimary}, Light={StaticResource TextSecondary}}" FontSize="Body" MinimumHeightRequest="0" Padding="0" LineBreakMode="WordWrap">
                        <Label.Triggers>

                            <DataTrigger TargetType="Label" Binding="{Binding IsSelf}" Value="True">
                                <Setter Property="Margin" Value="8,0,0,0"/>
                            </DataTrigger>

                            <DataTrigger TargetType="Label" Binding="{Binding IsSelf}" Value="False">
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </DataTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="True"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Expired"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="对方无应答"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="False"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Expired"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="无应答"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Abnormal"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="{Binding Duration,StringFormat='通话异常'}"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Ended"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="{Binding Duration, StringFormat='通话时长 {0:hh\\:mm\\:ss}'}" />
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="True"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Rejected"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="对方已拒绝"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="False"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Rejected"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="已拒绝"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="True"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Cancelled"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="已取消"/>
                            </MultiTrigger>

                            <MultiTrigger TargetType="Label">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding IsSelf}" Value="False"/>
                                    <BindingCondition Binding="{Binding Call_Status}" Value="Cancelled"/>
                                    <BindingCondition Binding="{Binding Chat_Type}" Value="Private"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Text" Value="对方已取消"/>
                            </MultiTrigger>

                        </Label.Triggers>
                    </Label>

                    <Path Grid.Column="2" Margin="8,0" WidthRequest="18" HeightRequest="18" Stroke="{AppThemeBinding Dark={StaticResource TextPrimary}, Light={StaticResource TextSecondary}}" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" Data="{StaticResource VideoIcon}" IsVisible="False" ScaleX="-1">
                        <Path.Triggers>
                            <DataTrigger TargetType="Path" Binding="{Binding IsSelf}" Value="True">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Path.Triggers>
                    </Path>

                </Grid>
            </Border>

        </Grid>

    </Grid>

</ContentView>