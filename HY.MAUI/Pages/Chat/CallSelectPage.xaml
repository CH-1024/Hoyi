<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HY.MAUI.Pages.Chat.CallSelectPage"
             xmlns:local="clr-namespace:HY.MAUI.Pages.Chat"
             x:Name="_CallSelectPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:pm="clr-namespace:HY.MAUI.PageModels.Chat"
             xmlns:m="clr-namespace:HY.MAUI.Models"
             xmlns:msgvm="clr-namespace:HY.MAUI.Models.MsgVM"
             xmlns:controls="clr-namespace:HY.MAUI.Controls"
             xmlns:ata="clr-namespace:HY.MAUI.AnimationTriggerActions"
             x:DataType="pm:CallSelectPageModel">


    <ContentPage.Resources>
        <ResourceDictionary>

            <Shadow x:Key="CardShadow" Brush="Black" Offset="0,1" Radius="5" Opacity="1" />

        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.Behaviors>
        <!--<toolkit:EventToCommandBehavior EventName="NavigatedTo" x:TypeArguments="NavigatedToEventArgs" Command="{Binding NavigatedToCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _CallSelectPage}, x:DataType=ContentPage}"/>-->
        <!--<toolkit:EventToCommandBehavior EventName="NavigatedFrom" x:TypeArguments="NavigatedFromEventArgs" Command="{Binding NavigatedFromCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _CallSelectPage}, x:DataType=ContentPage}"/>-->
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _CallSelectPage}, x:DataType=ContentPage}"/>
        <toolkit:EventToCommandBehavior EventName="Disappearing" Command="{Binding DisappearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _CallSelectPage}, x:DataType=ContentPage}" />
        <!--<toolkit:EventToCommandBehavior EventName="Loaded" Command="{Binding LoadedCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _CallSelectPage}, x:DataType=ContentPage}" />-->
        <!--<toolkit:EventToCommandBehavior EventName="Unloaded" Command="{Binding UnloadedCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _CallSelectPage}, x:DataType=ContentPage}" />-->
    </ContentPage.Behaviors>

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>



    <Grid RowDefinitions="*,*,*" BackgroundColor="{AppThemeBinding Light={StaticResource Gray050}, Dark={StaticResource SoftBlack}}">

        <Grid Grid.Row="0" RowDefinitions="*,auto,*">
            <Label Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" Text="是否接听？" FontSize="Medium"/>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="auto,auto,*">
            <Image Grid.Row="0" Source="{Binding CallerAvatar}" HeightRequest="100" WidthRequest="100" VerticalOptions="Center" Background="AliceBlue" Aspect="AspectFit" />
            <Label Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" Text="{Binding CallerName}" FontSize="Medium"/>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*">

            <Grid Grid.Column="0" >

                <!-- 动画 -->
                <Ellipse x:Name="ellipse1" WidthRequest="80" HeightRequest="80" Stroke="Blue" StrokeThickness="2" HorizontalOptions="Center" VerticalOptions="Center" Scale="1" Margin="0">
                    <Ellipse.Triggers>
                        <EventTrigger Event="Loaded">
                            <EventTrigger.Actions>
                                <ata:StartScaleTriggerAction From="1" To="1.5" Duration="1000" Easing="{x:Static Easing.CubicOut}" Repeat="True"/>
                                <ata:StartFadeTriggerAction From="1" To="0" Duration="1000" Easing="{x:Static Easing.CubicIn}" Repeat="True"/>
                            </EventTrigger.Actions>
                        </EventTrigger>

                        <EventTrigger Event="Unloaded">
                            <ata:StopScaleTriggerAction Value="1"/>
                            <ata:StopFadeTriggerAction Value="0"/>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <!--进度-->
                <!--<ActivityIndicator x:Name="activityIndicator1" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="80" HeightRequest="80" IsVisible="{Binding IsLoading}" Opacity="0.8" Color="LightGray" Margin="0" ZIndex="1">
                    <ActivityIndicator.Triggers>
                        <Trigger TargetType="ActivityIndicator" Property="IsVisible" Value="True">
                            <Setter Property="IsRunning" Value="True"/>
                        </Trigger>
                        <Trigger TargetType="ActivityIndicator" Property="IsVisible" Value="False">
                            <Setter Property="IsRunning" Value="False"/>
                        </Trigger>
                    </ActivityIndicator.Triggers>
                </ActivityIndicator>-->

                <!-- 按钮 -->
                <Button HorizontalOptions="Center" VerticalOptions="Center" Text="同意" FontSize="Medium" WidthRequest="80" HeightRequest="80" CornerRadius="40" BackgroundColor="#EEEEEE" Command="{Binding AcceptCommand}" Margin="0" Padding="0">
                    <!--<Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Path=IsVisible, Source={x:Reference activityIndicator1}}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding Path=IsVisible, Source={x:Reference activityIndicator1}}" Value="False">
                            <Setter Property="IsEnabled" Value="True"/>
                        </DataTrigger>
                    </Button.Triggers>-->
                </Button>

            </Grid>



            <Grid Grid.Column="1" >

                <!-- 动画 -->
                <Ellipse x:Name="ellipse2" WidthRequest="80" HeightRequest="80" Stroke="Blue" StrokeThickness="2" HorizontalOptions="Center" VerticalOptions="Center" Scale="1" Margin="0">
                    <Ellipse.Triggers>
                        <EventTrigger Event="Loaded">
                            <EventTrigger.Actions>
                                <ata:StartScaleTriggerAction From="1" To="1.5" Duration="1000" Easing="{x:Static Easing.CubicOut}" Repeat="True"/>
                                <ata:StartFadeTriggerAction From="1" To="0" Duration="1000" Easing="{x:Static Easing.CubicIn}" Repeat="True"/>
                            </EventTrigger.Actions>
                        </EventTrigger>

                        <EventTrigger Event="Unloaded">
                            <ata:StopScaleTriggerAction Value="1"/>
                            <ata:StopFadeTriggerAction Value="0"/>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <!--进度-->
                <!--<ActivityIndicator x:Name="activityIndicator2" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="80" HeightRequest="80" IsVisible="{Binding IsLoading}" Opacity="0.8" Color="LightGray" Margin="0" ZIndex="1">
                    <ActivityIndicator.Triggers>
                        <Trigger TargetType="ActivityIndicator" Property="IsVisible" Value="True">
                            <Setter Property="IsRunning" Value="True"/>
                        </Trigger>
                        <Trigger TargetType="ActivityIndicator" Property="IsVisible" Value="False">
                            <Setter Property="IsRunning" Value="False"/>
                        </Trigger>
                    </ActivityIndicator.Triggers>
                </ActivityIndicator>-->

                <!-- 按钮 -->
                <Button HorizontalOptions="Center" VerticalOptions="Center" Text="拒绝" FontSize="Medium" Shadow="{StaticResource CardShadow}" WidthRequest="80" HeightRequest="80" CornerRadius="40" BackgroundColor="OrangeRed" Command="{Binding RejectCommand}" Margin="0" Padding="0">
                    <!--<Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Path=IsVisible, Source={x:Reference activityIndicator2}}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding Path=IsVisible, Source={x:Reference activityIndicator2}}" Value="False">
                            <Setter Property="IsEnabled" Value="True"/>
                        </DataTrigger>
                    </Button.Triggers>-->
                </Button>

            </Grid>

        </Grid>

    </Grid>
</ContentPage>
