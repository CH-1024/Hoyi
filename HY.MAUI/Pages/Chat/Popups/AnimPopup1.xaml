<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="HY.MAUI.Pages.Chat.Popups.AnimPopup1"
    x:Name="popup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
    Margin="0" Padding="0" BackgroundColor="Transparent" 
    CanBeDismissedByTappingOutsideOfPopup="False">



    <Grid RowDefinitions="*,Auto" Loaded="OnAnimateEntry">

        <!-- 点击遮罩 -->
        <BoxView Grid.Row="0" BackgroundColor="Transparent" Margin="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAnimateExit"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!--真正的底部弹窗-->
        <Border x:Name="content" Grid.Row="1" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SoftBlack}}" Stroke="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource Gray700}}" StrokeThickness="1" StrokeShape="RoundRectangle 18,18,0,0" Margin="0,0,0,0" HeightRequest="{Binding Source={x:Reference popup}, Path=PopLength}" TranslationY="{Binding Source={x:Reference popup}, Path=TotalTranslateY}">
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnContentPanUpdated"/>
            </Border.GestureRecognizers>

            <VerticalStackLayout Margin="0" Padding="30" Spacing="15">
                <Label Text="Hello, World!" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"/>
                <!-- <Button Text="Done" Clicked="OnAnimateExit"/> -->
            </VerticalStackLayout>
        </Border>

    </Grid>

</toolkit:Popup>
