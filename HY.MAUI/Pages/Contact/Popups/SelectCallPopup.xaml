<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HY.MAUI.Pages.Contact.Popups.SelectCallPopup"
    x:Name="popup"
    x:TypeArguments="system:String"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
    Margin="0" Padding="0" BackgroundColor="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <toolkit:Popup.Resources>
        <ResourceDictionary>

            <Style x:Key="IconBtn1" TargetType="Button">
                <Setter Property="MinimumHeightRequest" Value="0"/>
                <Setter Property="MinimumWidthRequest" Value="0"/>
                <Setter Property="HeightRequest" Value="{OnIdiom Desktop=50, Phone=60}"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSecondary}, Dark=#252525}"/>
                <Setter Property="ContentLayout" Value="Top,0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="FontSize" Value="Micro"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"/>
                <Setter Property="HorizontalOptions" Value="Fill"/>
                <Setter Property="VerticalOptions" Value="Fill"/>
            </Style>

        </ResourceDictionary>
    </toolkit:Popup.Resources>


    <Grid RowDefinitions="*,Auto" Loaded="OnAnimateEntry">

        <!--点击遮罩-->
        <BoxView Grid.Row="0" BackgroundColor="Transparent" Margin="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAnimateExit"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!--真正的底部弹窗-->
        <Border x:Name="content" Grid.Row="1" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SoftBlack}}" Stroke="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource Gray700}}" StrokeThickness="1" StrokeShape="RoundRectangle 18,18,0,0" Margin="0,0,0,0" HeightRequest="{Binding Source={x:Reference popup}, Path=PopLength}" TranslationY="{Binding Source={x:Reference popup}, Path=TotalTranslateY}">
            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnContentPanUpdated"/>
            </Border.GestureRecognizers>

            <VerticalStackLayout Margin="0" Padding="30" Spacing="15">
                <Button Style="{StaticResource IconBtn1}" Text="语音通话" Clicked="Voice_Clicked"/>
                <Button Style="{StaticResource IconBtn1}" Text="视频通话" Clicked="Video_Clicked"/>
            </VerticalStackLayout>

        </Border>

    </Grid>

</toolkit:Popup>
