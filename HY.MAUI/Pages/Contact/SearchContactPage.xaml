<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HY.MAUI.Pages.Contact.SearchContactPage"
             x:Name="_SearchContactPage"
             Shell.NavBarIsVisible="{OnIdiom Phone=True, Desktop=True}"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             xmlns:maui="clr-namespace:HY.MAUI"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:enum="clr-namespace:HY.MAUI.Enums"
             xmlns:pm="clr-namespace:HY.MAUI.PageModels.Contact"
             xmlns:m="clr-namespace:HY.MAUI.Models"
             Padding="{OnIdiom Phone=0, Desktop=5}"
             x:DataType="pm:SearchContactPageModel"
             Loaded="SearchContactPage_OnLoaded">


    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="NavigatedTo" Command="{Binding NavigatedToCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _SearchContactPage}, x:DataType=ContentPage}"/>
        <toolkit:EventToCommandBehavior EventName="NavigatedFrom" Command="{Binding NavigatedFromCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _SearchContactPage}, x:DataType=ContentPage}"/>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _SearchContactPage}, x:DataType=ContentPage}"/>
        <!--<toolkit:EventToCommandBehavior EventName="Disappearing" Command="{Binding DisappearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _SearchContactPage}, x:DataType=ContentPage}" />-->
    </ContentPage.Behaviors>

    <!--<Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>-->

    <Shell.TitleView>
        <Grid HorizontalOptions="Center" VerticalOptions="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{OnPlatform WinUI=45,Default=0}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{OnPlatform Default=45}"/>
            </Grid.ColumnDefinitions>

            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True" IsVisible="{Binding Source={x:Static maui:MauiProgram.GlobalBindings}, Path=IsSyncing}" HorizontalOptions="Start" VerticalOptions="Center" Margin="0" WidthRequest="20" HeightRequest="20"/>
                <Label Text="添加联系人" TextColor="{AppThemeBinding Dark={StaticResource White}, Light={StaticResource Black}}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="18"/>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Text="添加" Order="Secondary" Priority="0" />
        <ToolbarItem Text="拉黑" Order="Secondary" Priority="0" />
    </ContentPage.ToolbarItems>-->

    <ScrollView>
        <Grid RowDefinitions="Auto,*" RowSpacing="10" Padding="8,0" BackgroundColor="{AppThemeBinding Light={StaticResource Gray050}, Dark={StaticResource SoftBlack}}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
            </Grid.GestureRecognizers>

            <SearchBar x:Name="searchBar" Margin="0,10,0,0" SearchCommand="{Binding SearchContactCommand}" SearchCommandParameter="{Binding Text, Source={RelativeSource Self}}" Placeholder="请输入 HYID / 手机号" />

        </Grid>

    </ScrollView>

</ContentPage>
