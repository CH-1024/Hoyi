<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HY.MAUI.Pages.Contact.SearchLocalContactPage"
             x:Name="_SearchLocalContactPage"
             Shell.NavBarIsVisible="{OnIdiom Phone=True, Desktop=True}"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             xmlns:maui="clr-namespace:HY.MAUI"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:enum="clr-namespace:HY.MAUI.Enums"
             xmlns:pm="clr-namespace:HY.MAUI.PageModels.Contact"
             xmlns:m="clr-namespace:HY.MAUI.Models"
             Padding="{OnIdiom Phone=0, Desktop=5}"
             x:DataType="pm:SearchLocalContactPageModel"
             Loaded="SearchContactPage_OnLoaded">

    <ContentPage.Behaviors>
        <!-- <toolkit:EventToCommandBehavior EventName="NavigatedTo" Command="{Binding NavigatedToCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _SearchLocalContactPage}, x:DataType=ContentPage}"/> -->
        <!-- <toolkit:EventToCommandBehavior EventName="NavigatedFrom" Command="{Binding NavigatedFromCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _SearchLocalContactPage}, x:DataType=ContentPage}"/> -->
        <!-- <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _SearchLocalContactPage}, x:DataType=ContentPage}" /> -->
        <!--<toolkit:EventToCommandBehavior EventName="Disappearing" Command="{Binding DisappearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _SearchLocalContactPage}, x:DataType=ContentPage}" />-->
    </ContentPage.Behaviors>

    <Shell.TitleView>
        <Grid HorizontalOptions="Center" VerticalOptions="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{OnPlatform WinUI=45,Default=0}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{OnPlatform Default=45}"/>
            </Grid.ColumnDefinitions>

            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True" IsVisible="{Binding Source={x:Static maui:MauiProgram.GlobalBindings}, Path=IsSyncing}" HorizontalOptions="Start" VerticalOptions="Center" Margin="0" WidthRequest="20" HeightRequest="20"/>
                <Label Text="搜索" TextColor="{AppThemeBinding Dark={StaticResource White}, Light={StaticResource Black}}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="18"/>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <!-- <ContentPage.ToolbarItems> -->
    <!--     <ToolbarItem Text="扫一扫" Order="Secondary" Priority="0" /> -->
    <!-- </ContentPage.ToolbarItems> -->

    <ScrollView>
        <Grid RowDefinitions="Auto,*" RowSpacing="10" Padding="8,0" BackgroundColor="{AppThemeBinding Light={StaticResource Gray050}, Dark={StaticResource SoftBlack}}">
            <SearchBar x:Name="searchBar" Margin="0,10,0,0"/>

            <CollectionView Grid.Row="1" ItemsSource="{Binding ContactCollection}" SelectedItem="{Binding SelectedContact}" SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="0" Orientation="Vertical"/>
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <ContentView>
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="No results matched your filter." Margin="10,25,10,10" FontAttributes="Bold" FontSize="18" HorizontalOptions="Fill" HorizontalTextAlignment="Center" />
                            <Label Text="Try a broader filter?" FontAttributes="Italic" FontSize="12" HorizontalOptions="Fill" HorizontalTextAlignment="Center" />
                        </StackLayout>
                    </ContentView>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:ContactVM">
                        <Border Padding="5" StrokeThickness="0">
                            <Grid ColumnDefinitions="50,*" ColumnSpacing="5">
                                <toolkit:AvatarView ImageSource="{Binding Avatar}" BackgroundColor="Transparent" StrokeThickness="0" CornerRadius="5" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center" VerticalOptions="Center" Padding="0" Margin="0"/>

                                <Label Grid.Column="1" Text="{Binding Nickname}" FontSize="Body" Padding="0" VerticalOptions="Start"/>

                                <BoxView Grid.Column="1" Color="{StaticResource Gray800}" HeightRequest="1" HorizontalOptions="Fill" VerticalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </ScrollView>
</ContentPage>