<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HY.MAUI.Pages.Contact.ContactPage"
             x:Name="_ContactPage"
             Shell.NavBarIsVisible="{OnIdiom Phone=True, Desktop=True}"
             Shell.TabBarIsVisible="False"
             xmlns:maui="clr-namespace:HY.MAUI"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:pm="clr-namespace:HY.MAUI.PageModels.Contact"
             xmlns:m="clr-namespace:HY.MAUI.Models"
             xmlns:controls="clr-namespace:HY.MAUI.Controls"
             x:DataType="pm:ContactPageModel">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Style x:Key="IconBtn1" TargetType="Button">
                <Setter Property="MinimumHeightRequest" Value="0"/>
                <Setter Property="MinimumWidthRequest" Value="0"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray950}, Light={StaticResource Gray000}}"/>
                <Setter Property="ContentLayout" Value="Left,0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderWidth" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource TextPrimary}, Light={StaticResource TextSecondary}}"/>
                <Setter Property="HorizontalOptions" Value="Fill"/>
                <Setter Property="VerticalOptions" Value="Fill"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="NavigatedTo" Command="{Binding NavigatedToCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _ContactPage}, x:DataType=ContentPage}"/>
        <toolkit:EventToCommandBehavior EventName="NavigatedFrom" Command="{Binding NavigatedFromCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _ContactPage}, x:DataType=ContentPage}"/>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _ContactPage}, x:DataType=ContentPage}" />
        <toolkit:EventToCommandBehavior EventName="Disappearing" Command="{Binding DisappearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _ContactPage}, x:DataType=ContentPage}" />
    </ContentPage.Behaviors>

    <Shell.TitleView>
        <Label Margin="{OnPlatform WinUI='45,0,0,0', Default='0,0,0,0'}" Text="好友" TextColor="{AppThemeBinding Dark={StaticResource White}, Light={StaticResource Black}}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="18"/>
    </Shell.TitleView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="扫一扫" Order="Secondary" Priority="0" />
        <ToolbarItem Text="添加联系人" Order="Secondary" Priority="1" Command="{Binding SearchContactCommand}"/>
    </ContentPage.ToolbarItems>

    
    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" Padding="8,0" BackgroundColor="{AppThemeBinding Light={StaticResource Gray050}, Dark={StaticResource SoftBlack}}">
            <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
                <ScrollView>

                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">

                        <SearchBar x:Name="searchBar" Margin="0,10,0,0" Focused="SearchBar_OnFocused"/>

                        <BoxView IsVisible="{OnPlatform iOS=True, MacCatalyst=True,Default=False}" Color="{AppThemeBinding Dark={StaticResource Gray800}, Light={StaticResource Gray100}}" HeightRequest="1" HorizontalOptions="Fill" VerticalOptions="End" />

                        <Border Grid.Row="1" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="1">
                                <Button Grid.Column="0" Style="{StaticResource IconBtn1}" Text="申请中" Command="{Binding RequestCommand}"/>
                                <controls:BadgeView Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Margin="80,0,0,0" BadgeColor="#FF453A" TextColor="White" ZIndex="1"
                                                    IsVisible="{Binding Source={x:Static maui:MauiProgram.GlobalBindings}, Path=RequestContactCountVisible}"
                                                    Text="{Binding Source={x:Static maui:MauiProgram.GlobalBindings}, Path=RequestContactCountShow}"/>

                                <Button Grid.Column="1" Style="{StaticResource IconBtn1}" Text="待同意" Command="{Binding RespondCommand}"/>
                                <controls:BadgeView Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Margin="80,0,0,0" BadgeColor="#FF453A" TextColor="White" ZIndex="1"
                                                    IsVisible="{Binding Source={x:Static maui:MauiProgram.GlobalBindings}, Path=RespondContactCountVisible}"
                                                    Text="{Binding Source={x:Static maui:MauiProgram.GlobalBindings}, Path=RespondContactCountShow}"/>
                            </Grid>
                        </Border>

                        <Picker Grid.Row="2" Margin="0" Title="类型：" SelectedIndex="0">
                            <Picker.Items>
                                <x:String>好友</x:String>
                                <x:String>群组</x:String>
                            </Picker.Items>
                        </Picker>

                        <CollectionView Grid.Row="3" ItemsSource="{Binding ContactCollection}" SelectedItem="{Binding SelectedContact}" SelectionMode="Single" SelectionChangedCommand="{Binding SelectionChangedCommand}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="0" Orientation="Vertical"/>
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="m:ContactVM">
                                    <Border Padding="8" StrokeThickness="0">

                                        <Grid ColumnDefinitions="50,*" ColumnSpacing="5">
                                            <toolkit:AvatarView ImageSource="{Binding Avatar}" BackgroundColor="Black" StrokeThickness="0" CornerRadius="5" WidthRequest="50" HeightRequest="50" HorizontalOptions="Start" VerticalOptions="Center" Padding="0" Margin="0"/>

                                            <Label Grid.Column="1" Text="{Binding Nickname}" TextColor="{AppThemeBinding Dark={StaticResource TextPrimary}, Light={StaticResource TextSecondary}}" FontSize="Body" Padding="0" VerticalOptions="Center"/>

                                            <BoxView Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Color="{AppThemeBinding Dark={StaticResource Gray800}, Light={StaticResource Gray100}}" HeightRequest="1" HorizontalOptions="Fill" VerticalOptions="End" />
                                        </Grid>

                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Grid>

                </ScrollView>
            </RefreshView>
        </Grid>

        <controls:BottomTabBar Grid.Row="1"/>
    </Grid>

</ContentPage>
