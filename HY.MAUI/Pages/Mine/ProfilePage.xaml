<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HY.MAUI.Pages.Mine.ProfilePage"
             x:Name="_ProfilePage"
             Shell.NavBarIsVisible="{OnIdiom Phone=True, Desktop=True}"
             Shell.TabBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             xmlns:maui="clr-namespace:HY.MAUI"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:pm="clr-namespace:HY.MAUI.PageModels.Mine"
             xmlns:m="clr-namespace:HY.MAUI.Models"
             xmlns:controls="clr-namespace:HY.MAUI.Controls"
             x:DataType="pm:ProfilePageModel">


    <ContentPage.Resources>
        <ResourceDictionary>

            <Style x:Key="IconBtn1" TargetType="Button">
                <Setter Property="MinimumHeightRequest" Value="0"/>
                <Setter Property="MinimumWidthRequest" Value="0"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource Gray900}, Light={StaticResource Gray000}}"/>
                <Setter Property="BorderColor" Value="{AppThemeBinding Dark={StaticResource Gray600}, Light={StaticResource Gray100}}"/>
                <Setter Property="ContentLayout" Value="Left,0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderWidth" Value="1"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{AppThemeBinding Dark={StaticResource TextPrimary}, Light={StaticResource TextSecondary}}"/>
                <Setter Property="HorizontalOptions" Value="Fill"/>
                <Setter Property="VerticalOptions" Value="Fill"/>
            </Style>

            <Style x:Key="InEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Dark={StaticResource SoftBlack}, Light={StaticResource SoftWhite}}"/>
                <Setter Property="ReturnType" Value="Next"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.Behaviors>
        <!--<toolkit:EventToCommandBehavior EventName="NavigatedTo" Command="{Binding NavigatedToCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _ProfilePage}, x:DataType=ContentPage}"/>-->
        <!--<toolkit:EventToCommandBehavior EventName="NavigatedFrom" Command="{Binding NavigatedFromCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _ProfilePage}, x:DataType=ContentPage}"/>-->
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _ProfilePage}, x:DataType=ContentPage}" />
        <!--<toolkit:EventToCommandBehavior EventName="Disappearing" Command="{Binding DisappearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _ProfilePage}, x:DataType=ContentPage}" />-->
    </ContentPage.Behaviors>

    <!--<Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>-->

    <Shell.TitleView>
        <Grid HorizontalOptions="Center" VerticalOptions="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{OnPlatform WinUI=45, Default=0}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True" IsVisible="{Binding Source={x:Static maui:MauiProgram.GlobalBindings}, Path=IsSyncing}" HorizontalOptions="Start" VerticalOptions="Center" Margin="0" WidthRequest="20" HeightRequest="20"/>
                <Label Text="个人资料" TextColor="{AppThemeBinding Dark={StaticResource White}, Light={StaticResource Black}}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="18"/>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="编辑" Order="Secondary" Priority="0"/>
        <ToolbarItem Text="更换头像" Order="Secondary" Priority="1" Command="{Binding ChangeAvatarCommand}"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" BackgroundColor="{AppThemeBinding Light={StaticResource Gray050}, Dark={StaticResource SoftBlack}}">

            <toolkit:AvatarView ImageSource="{Binding CurrentUser.Avatar}" BackgroundColor="Transparent" StrokeThickness="0" CornerRadius="18" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" VerticalOptions="Center" Padding="0" Margin="0">
                <FlyoutBase.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="下载"/>
                    </MenuFlyout>
                </FlyoutBase.ContextFlyout>
            </toolkit:AvatarView>

            <!--头像 
            <Grid HorizontalOptions="Center">

                <toolkit:AvatarView ImageSource="{Binding CurrentUser.Avatar}" BackgroundColor="Black" StrokeThickness="0" CornerRadius="18" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" VerticalOptions="Center" Padding="0" Margin="0"/>

                 更换头像按钮 
                <Button Text="✎" WidthRequest="36" HeightRequest="36" CornerRadius="18" FontSize="30" Padding="0" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="End" Command="{Binding ChangeAvatarCommand}"/>
            </Grid>-->

            <VerticalStackLayout>
                <Label Text="姓名" FontSize="14" TextColor="Gray"/>
                <Entry Style="{StaticResource InEntry}" Text="{Binding RealName}" Placeholder="请输入姓名"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="昵称" FontSize="14" TextColor="Gray"/>
                <Entry Style="{StaticResource InEntry}" Text="{Binding CurrentUser.Nickname}" Placeholder="请输入昵称"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="手机号" FontSize="14" TextColor="Gray"/>
                <Entry Style="{StaticResource InEntry}" Text="{Binding CurrentUser.Phone}" Placeholder="请输入手机号"/>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="邮箱" FontSize="14" TextColor="Gray"/>
                <Entry Style="{StaticResource InEntry}" Text="{Binding CurrentUser.Email}" Placeholder="请输入邮箱"/>
            </VerticalStackLayout>

            <Button Style="{StaticResource IconBtn1}" Text="保存" Command="{Binding SaveCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
