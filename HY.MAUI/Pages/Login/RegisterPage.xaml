<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HY.MAUI.Pages.Login.RegisterPage"
             x:Name="_RegisterPage"
             NavigationPage.HasNavigationBar="False"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:pm="clr-namespace:HY.MAUI.PageModels.Login"
             xmlns:m="clr-namespace:HY.MAUI.Models"
             x:DataType="pm:RegisterPageModel"
             BackgroundColor="#F5F6FC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>


    <ContentPage.Behaviors>
        <!--<toolkit:EventToCommandBehavior EventName="NavigatedTo" Command="{Binding NavigatedToCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _LoginPage}, x:DataType=ContentPage}"/>-->
        <!--<toolkit:EventToCommandBehavior EventName="NavigatedFrom" Command="{Binding NavigatedFromCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _LoginPage}, x:DataType=ContentPage}"/>-->
        <!--<toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _LoginPage}, x:DataType=ContentPage}" />-->
        <!--<toolkit:EventToCommandBehavior EventName="Disappearing" Command="{Binding DisappearingCommand}" BindingContext="{Binding Path=BindingContext, Source={x:Reference _LoginPage}, x:DataType=ContentPage}" />-->
    </ContentPage.Behaviors>

    <Grid>

        <!-- 背景装饰 -->
        <Border WidthRequest="200"
                HeightRequest="200"
                StrokeThickness="0"
                BackgroundColor="#E9E8FF"
                Opacity="0.65"
                StrokeShape="RoundRectangle 140"
                HorizontalOptions="End"
                VerticalOptions="Start"
                TranslationX="100"
                TranslationY="0" >
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E9E8FF" Offset="0" />
                    <GradientStop Color="#5145CE" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border WidthRequest="230"
                HeightRequest="230"
                StrokeThickness="0"
                BackgroundColor="#E9F0FF"
                Opacity="0.7"
                StrokeShape="RoundRectangle 115"
                HorizontalOptions="Start"
                VerticalOptions="End"
                TranslationX="-100"
                TranslationY="100" >
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5145CE" Offset="0" />
                    <GradientStop Color="#E9F0FF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        
        <ScrollView VerticalOptions="Center" HorizontalOptions="Fill">

            <VerticalStackLayout Spacing="0" Padding="0" HorizontalOptions="Fill">

                <!-- Hoyi 品牌 -->
                <!--<HorizontalStackLayout Spacing="12" HorizontalOptions="Center">

                    <Border WidthRequest="48"
                            HeightRequest="48"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 15">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7568F5" Offset="0" />
                                <GradientStop Color="#5145CE" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Label Text="h"
                               FontSize="34"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>

                    <Label Text="hoyi"
                           FontSize="35"
                           FontAttributes="Bold"
                           TextColor="#282746"
                           VerticalOptions="Center"
                           CharacterSpacing="-1.5" />

                </HorizontalStackLayout>-->

                <!-- 页面标题 -->
                <VerticalStackLayout Spacing="8" Margin="0,28">

                    <Label Text="创建你的账号" FontSize="30" FontAttributes="Bold" TextColor="#24243A" HorizontalTextAlignment="Center" />

                    <Label Text="加入 Hoyi，开启全新的沟通体验" FontSize="14" TextColor="#8B8DA3" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

                </VerticalStackLayout>

                <!-- 注册卡片 -->
                <Border
                    BackgroundColor="White"
                    Stroke="#ECECF4"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="28" 
                    Margin="38" 
                    Shadow="{Shadow Radius=20, Opacity=0.08, Offset='0,8'}"
                    IsEnabled="{Binding RegisterCommand.IsRunning, Converter={StaticResource InvertedBoolConverter}}">

                    <VerticalStackLayout Spacing="0">

                        <Label Text="注册信息" FontSize="21" FontAttributes="Bold" TextColor="#292940" />

                        <Label Text="请填写以下信息以创建新账号" FontSize="13" TextColor="#999AAF" Margin="0,7,0,26" />

                        <!-- 昵称 -->
                        <Label Text="昵称" FontSize="13" FontAttributes="Bold" TextColor="#55566C" Margin="0,0,0,9" />

                        <Border BackgroundColor="#F7F8FC" Stroke="#E9EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 13" Padding="14,0" HeightRequest="52">

                            <Entry Text="{Binding Nickname}"
                                   Placeholder="请输入昵称"
                                   PlaceholderColor="#B2B4C3"
                                   TextColor="#292940"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   ClearButtonVisibility="WhileEditing"
                                   VerticalOptions="Center"
                                   ReturnType="Next" />
                        </Border>

                        <!-- 用户名 -->
                        <Label Text="用户名" FontSize="13" FontAttributes="Bold" TextColor="#55566C" Margin="0,17,0,8" />

                        <Border BackgroundColor="#F7F8FC" Stroke="#E9EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="52">

                            <Entry Text="{Binding Username}"
                                   Placeholder="请输入用户名"
                                   PlaceholderColor="#B2B4C3"
                                   TextColor="#292940"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   ClearButtonVisibility="WhileEditing"
                                   VerticalOptions="Center"
                                   ReturnType="Next" />
                        </Border>

                        <!-- 邮箱 -->
                        <Label Text="邮箱" FontSize="13" FontAttributes="Bold" TextColor="#55566C" Margin="0,17,0,8" />

                        <Border BackgroundColor="#F7F8FC" Stroke="#E9EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="52">

                            <Entry Text="{Binding Email}"
                                   Placeholder="请输入邮箱地址"
                                   PlaceholderColor="#B2B4C3"
                                   TextColor="#292940"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   Keyboard="Email"
                                   ClearButtonVisibility="WhileEditing"
                                   VerticalOptions="Center"
                                   ReturnType="Next" />
                        </Border>

                        <!-- 电话 -->
                        <Label Text="手机号" FontSize="13" FontAttributes="Bold" TextColor="#55566C" Margin="0,17,0,8" />

                        <Border BackgroundColor="#F7F8FC" Stroke="#E9EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="52">

                            <Entry Text="{Binding Phone}"
                                   Placeholder="请输入手机号码"
                                   PlaceholderColor="#B2B4C3"
                                   TextColor="#292940"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   Keyboard="Telephone"
                                   ClearButtonVisibility="WhileEditing"
                                   VerticalOptions="Center"
                                   ReturnType="Next" />
                        </Border>

                        <!-- 密码分隔 -->
                        <BoxView HeightRequest="1" BackgroundColor="#ECECF4" Margin="0,24,0,20" />

                        <Label Text="设置密码" FontSize="16" FontAttributes="Bold" TextColor="#292940" Margin="0,0,0,16" />

                        <!-- 密码 -->
                        <Label Text="登录密码" FontSize="13" FontAttributes="Bold" TextColor="#55566C" Margin="0,0,0,8" />

                        <Border BackgroundColor="#F7F8FC" Stroke="#E9EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="52">

                            <Entry Text="{Binding Password}"
                                   Placeholder="请设置登录密码"
                                   PlaceholderColor="#B2B4C3"
                                   TextColor="#292940"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   IsPassword="True"
                                   VerticalOptions="Center"
                                   ReturnType="Next" />
                        </Border>

                        <!-- 确认密码 -->
                        <Label Text="确认密码" FontSize="13" FontAttributes="Bold" TextColor="#55566C" Margin="0,17,0,8" />

                        <Border BackgroundColor="#F7F8FC" Stroke="#E9EAF2" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0" HeightRequest="52">

                            <Entry Text="{Binding ConfirmPassword}"
                                   Placeholder="请再次输入密码"
                                   PlaceholderColor="#B2B4C3"
                                   TextColor="#292940"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   IsPassword="True"
                                   VerticalOptions="Center"
                                   ReturnType="Go" />
                        </Border>

                        <!-- 注册按钮 -->
                        <Button
                            Text="立即注册"
                            Command="{Binding RegisterCommand}"
                            BackgroundColor="#6256DC"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="13"
                            HeightRequest="54"
                            Margin="0,28,0,0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />

                        <!-- 返回登录 -->
                        <Border BackgroundColor="Transparent" Stroke="Transparent" StrokeThickness="1" StrokeShape="RoundRectangle 13" Margin="0,15,0,0" HeightRequest="54">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackCommand}"/>
                            </Border.GestureRecognizers>

                            <Label Text="已有账号？返回登录"
                                BackgroundColor="Transparent"
                                TextColor="#6256DC"
                                FontSize="14"
                                FontAttributes="Bold"
                                HeightRequest="48"
                                Padding="8,0"
                                HorizontalTextAlignment="Center" />

                        </Border>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

        <!-- 底部品牌信息 -->
        <VerticalStackLayout VerticalOptions="End">

            <Label
                Text="让沟通更简单，让连接更自由"
                FontSize="13"
                TextColor="#9293A8"
                HorizontalTextAlignment="Center" />

            <Label
                Text="HOYI · CONNECT EVERYTHING"
                FontSize="10"
                TextColor="#B7B8C8"
                CharacterSpacing="2"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <ActivityIndicator
            Color="Gray"
            IsRunning="{Binding RegisterCommand.IsRunning}"
            IsVisible="{Binding RegisterCommand.IsRunning}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Margin="0,0,0,0"
            InputTransparent="True" />

    </Grid>

</ContentPage>
